<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/system_black">

    <LinearLayout
        android:id="@+id/home_pane"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/screen_pad">

        <!-- LEFT COLUMN: status / clock / media / actions -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <xyz.montylabs.lineout.MonoTextView
                    android:id="@+id/status_left"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/status_left"
                    android:textColor="@color/signal_green"
                    android:textSize="@dimen/status_size"
                    android:letterSpacing="0.15"
                    app:mfont="jbBold" />

                <xyz.montylabs.lineout.MonoTextView
                    android:id="@+id/status_batt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/dim_white"
                    android:textSize="@dimen/status_size"
                    app:mfont="plex" />
            </LinearLayout>

            <xyz.montylabs.lineout.MonoTextView
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="26dp"
                android:text=""
                android:textColor="@color/stark_white"
                android:textSize="@dimen/clock_size"
                android:includeFontPadding="false"
                app:mfont="jbBold" />

            <xyz.montylabs.lineout.MonoTextView
                android:id="@+id/date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text=""
                android:textColor="@color/dim_white"
                android:textSize="@dimen/date_size"
                app:mfont="plex" />

            <xyz.montylabs.lineout.MonoTextView
                android:id="@+id/set_default_chip"
                style="@style/MontyBtn.Green"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/set_default"
                android:textSize="13sp"
                android:visibility="gone"
                app:mfont="jbMedium" />

            <LinearLayout
                android:id="@+id/np_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:orientation="vertical"
                android:background="@drawable/border_green"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <xyz.montylabs.lineout.MonoTextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/np_header"
                        android:textColor="@color/signal_green"
                        android:textSize="12sp"
                        android:letterSpacing="0.2"
                        app:mfont="jbBold" />

                    <xyz.montylabs.lineout.MonoTextView
                        android:id="@+id/np_src"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/dim_white"
                        android:textSize="11sp"
                        app:mfont="plex" />
                </LinearLayout>

                <xyz.montylabs.lineout.MonoTextView
                    android:id="@+id/np_state"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/np_waiting"
                    android:textColor="@color/dim_white"
                    android:textSize="13sp"
                    app:mfont="plex" />

                <xyz.montylabs.lineout.MonoTextView
                    android:id="@+id/np_grant"
                    style="@style/MontyBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/np_grant"
                    android:textSize="13sp"
                    android:visibility="gone"
                    app:mfont="jbMedium" />

                <LinearLayout
                    android:id="@+id/np_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/np_art"
                            android:layout_width="@dimen/np_art"
                            android:layout_height="@dimen/np_art"
                            android:layout_marginRight="16dp"
                            android:scaleType="centerCrop"
                            android:background="@drawable/border_white"
                            android:contentDescription="@string/np_header" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <xyz.montylabs.lineout.MonoTextView
                                android:id="@+id/np_title"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/stark_white"
                                android:textSize="@dimen/np_title"
                                android:singleLine="true"
                                android:ellipsize="end"
                                app:mfont="jbBold" />

                            <xyz.montylabs.lineout.MonoTextView
                                android:id="@+id/np_artist"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="3dp"
                                android:text=""
                                android:textColor="@color/dim_white"
                                android:textSize="13sp"
                                android:singleLine="true"
                                android:ellipsize="end"
                                app:mfont="plex" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="2dp"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <View
                            android:id="@+id/np_prog_fill"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="0"
                            android:background="@color/signal_green" />

                        <View
                            android:id="@+id/np_prog_rest"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@color/line_dim" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:orientation="horizontal">

                        <xyz.montylabs.lineout.MonoTextView
                            android:id="@+id/np_prev"
                            style="@style/MontyBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_prev"
                            app:mfont="jbBold" />

                        <xyz.montylabs.lineout.MonoTextView
                            android:id="@+id/np_play"
                            style="@style/MontyBtn.Green"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1.4"
                            android:layout_marginLeft="10dp"
                            android:layout_marginRight="10dp"
                            android:text="@string/btn_play"
                            app:mfont="jbBold" />

                        <xyz.montylabs.lineout.MonoTextView
                            android:id="@+id/np_next"
                            style="@style/MontyBtn"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/btn_next"
                            app:mfont="jbBold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <xyz.montylabs.lineout.MonoTextView
                    android:id="@+id/btn_apps"
                    style="@style/MontyBtn.Green"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/btn_apps"
                    app:mfont="jbBold" />

                <xyz.montylabs.lineout.MonoTextView
                    android:id="@+id/btn_sys"
                    style="@style/MontyBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="12dp"
                    android:text="@string/btn_sys"
                    app:mfont="jbBold" />
            </LinearLayout>
        </LinearLayout>

        <!-- RIGHT COLUMN: pinned apps -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="0.5"
            android:layout_marginLeft="28dp"
            android:orientation="vertical">

            <xyz.montylabs.lineout.MonoTextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fav_header"
                android:textColor="@color/signal_green"
                android:textSize="12sp"
                android:letterSpacing="0.2"
                app:mfont="jbBold" />

            <ScrollView
                android:id="@+id/fav_scroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="8dp"
                android:fillViewport="true"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:id="@+id/fav_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <xyz.montylabs.lineout.MonoTextView
                        android:id="@+id/fav_empty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/fav_empty"
                        android:textColor="@color/dim_white"
                        android:textSize="13sp"
                        app:mfont="plex" />
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/system_black"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/screen_pad">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <xyz.montylabs.lineout.MonoTextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/drawer_title"
                    android:textColor="@color/signal_green"
                    android:textSize="13sp"
                    android:letterSpacing="0.2"
                    app:mfont="jbBold" />

                <xyz.montylabs.lineout.MonoTextView
                    android:id="@+id/drawer_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/dim_white"
                    android:textSize="13sp"
                    app:mfont="plex" />
            </LinearLayout>

            <xyz.montylabs.lineout.MonoEditText
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/input_underline"
                android:hint="@string/search_hint"
                android:textColor="@color/stark_white"
                android:textColorHint="@color/dim_white"
                android:textSize="16sp"
                android:textCursorDrawable="@drawable/cursor_green"
                android:inputType="text"
                android:imeOptions="actionGo"
                android:singleLine="true"
                android:paddingTop="10dp"
                android:paddingBottom="10dp" />

            <GridView
                android:id="@+id/app_grid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="12dp"
                android:numColumns="@integer/drawer_cols"
                android:horizontalSpacing="24dp"
                android:scrollbars="none"
                android:overScrollMode="never"
                android:listSelector="@color/green_dim"
                android:cacheColorHint="@color/system_black" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
